{
  "name": "mylimits",
  "version": "2.1.0",
  "private": true,
  "description": "Your AI usage limits, accounts, and reset times in one place.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-typescript.mjs ./scripts/run-tests.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:companion && npm run build",
    "postinstall": "wxt prepare",
    "companion:install": "node companion/install.mjs",
    "companion:start": "node companion/daemon.mjs",
    "test:companion": "node companion/companion.test.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip:firefox": "wxt zip -b firefox",
    "build:edge": "wxt build -b edge",
    "package:companion": "node scripts/package-companion.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wxt": "^0.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
