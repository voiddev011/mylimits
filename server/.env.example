# Operator configuration; never commit a real .env or credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:8787
DATABASE_URL=postgresql://mylimits:CHANGE_ME@127.0.0.1:5432/mylimits
# Managed MyLimits identity provider, not an AI provider login.
OIDC_ISSUER=https://YOUR_ISSUER
OIDC_AUDIENCE=YOUR_API_AUDIENCE
OIDC_JWKS_URI=https://YOUR_ISSUER/keys
OIDC_AUTHORIZATION_ENDPOINT=https://YOUR_ISSUER/authorize
OIDC_TOKEN_ENDPOINT=https://YOUR_ISSUER/token
OIDC_CLIENT_ID=YOUR_CLIENT_ID
# Set only if your confidential OIDC client requires it.
# OIDC_CLIENT_SECRET=
# Exact web/extension origins separated by commas; never '*'.
ALLOWED_ORIGINS=
