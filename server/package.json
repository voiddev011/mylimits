{
  "name":"mylimits-server","version":"2.0.0","private":true,"type":"module",
  "engines":{"node":">=24"},
  "scripts":{
    "start":"node --import ../scripts/register-typescript.mjs src/main.ts",
    "migrate":"node --import ../scripts/register-typescript.mjs src/migrate.ts",
    "typecheck":"tsc --noEmit -p tsconfig.json",
    "test":"node --import ../scripts/register-typescript.mjs --test tests/*.test.ts",
    "check":"npm run typecheck && npm test"
  },
  "dependencies":{"fastify":"^5.6.0","pg":"^8.16.0","jose":"^6.1.0","zod":"^4.0.0"},
  "devDependencies":{"@types/pg":"^8.15.0","@types/node":"^24.0.0","typescript":"^5.9.0"}
}
